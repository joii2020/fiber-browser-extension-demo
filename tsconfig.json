{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["DOM", "ES2022"],
    "skipLibCheck": true
  },
  "include": ["entrypoints/**/*.ts", "src/**/*.ts", "wxt.config.ts", "env.d.ts"]
}
